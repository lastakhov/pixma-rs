#!/bin/bash

# Register every discovered Canon printer with CUPS for printing, each with a
# unique queue name so multiple PIXMA devices coexist.
#
# Scanning is separate: pixma-bridge advertises each Canon as its own AirScan
# (_uscan._tcp) device. Open Image Capture or Preview — the scanner appears
# there under the printer's network name, not inside the CUPS print queue.

# Collect Canon dnssd URIs discovered by CUPS (Bonjour may need a few seconds
# after install to surface them).
URIS=""
for attempt in 1 2 3 4 5 6 8 10; do
    URIS=$(lpinfo -v 2>/dev/null | awk '/dnssd:\/\// && /[Cc]anon/ {print $2}')
    [ -n "$URIS" ] && break
    sleep 2
done

# Fall back to static IPs from our own mDNS discovery if CUPS did not surface a
# dnssd URI (e.g. Bonjour blocked). Less robust against DHCP changes.
if [ -z "$URIS" ]; then
    URIS=$(/usr/local/bin/pixma discover 2>/dev/null | awk '/^  IP:/ {print "ipp://"$2":631/ipp/print"}')
fi

# Derive a CUPS-safe queue name from the device URI:
#   dnssd://Canon%20G3010%20series._ipp._tcp.local/ -> Canon_G3010_series
#   ipp://192.168.1.50:631/ipp/print                -> Canon_192_168_1_50
queue_name() {
    case "$1" in
        ipp://*)
            printf 'Canon_%s' "$(printf '%s' "$1" | sed -e 's|^ipp://||' -e 's|:.*$||' | tr . _)"
            ;;
        *)
            printf '%s' "$1" \
                | sed -e 's|^dnssd://||' -e 's|\._ipp._tcp\.local.*$||' \
                | sed -e 's|%[0-9A-Fa-f][0-9A-Fa-f]|_|g' \
                | tr -c 'A-Za-z0-9_' '_'
            ;;
    esac
}

i=0
seen=" "
for uri in $URIS; do
    i=$((i+1))
    name=$(queue_name "$uri")
    [ -n "$name" ] || name="Canon_$i"
    # Disambiguate identical models (same mDNS instance name) with a suffix.
    case "$seen" in
        *" $name "*) name="${name}_$i" ;;
    esac
    seen="$seen$name "

    lpadmin -p "$name" -E -v "$uri" -m everywhere 2>/dev/null \
        && echo "Registered printer queue '$name' -> $uri"
done

LABEL="com.pdrgds.pixma-bridge"
DAEMON_PLIST="/Library/LaunchDaemons/${LABEL}.plist"
AGENT_PLIST="/Library/LaunchAgents/${LABEL}.plist"
SRC_PLIST="/usr/local/share/pixma/${LABEL}.plist"

# One system-wide bridge (LaunchDaemon). Older installs used LaunchAgents and
# could leave two copies running, which breaks scanning in Image Capture.
pkill -f /usr/local/bin/pixma-bridge 2>/dev/null || true
sleep 1
pkill -9 -f /usr/local/bin/pixma-bridge 2>/dev/null || true
pkill -f "dns-sd -R .* _uscan._tcp" 2>/dev/null || true

launchctl bootout system "$DAEMON_PLIST" 2>/dev/null || true
launchctl bootout "gui/$(id -u)" "$AGENT_PLIST" 2>/dev/null || true
launchctl unload "$AGENT_PLIST" 2>/dev/null || true
rm -f "$AGENT_PLIST"

mkdir -p /Library/LaunchDaemons
cp "$SRC_PLIST" "$DAEMON_PLIST"
chmod 644 "$DAEMON_PLIST"

launchctl bootstrap system "$DAEMON_PLIST" 2>/dev/null \
    || launchctl load -w "$DAEMON_PLIST" 2>/dev/null
launchctl kickstart -k "system/${LABEL}" 2>/dev/null || true

echo ""
echo "Printing: use the Canon queue in System Settings -> Printers."
echo "Scanning: open Image Capture (or Preview -> Import from Scanner);"
echo "          the scanner appears as a separate device with the printer name."

exit 0
